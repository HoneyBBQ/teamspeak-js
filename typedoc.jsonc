{
  "$schema": "https://typedoc.org/schema.json",
  // One module per entry point users import: `@honeybbq/teamspeak` (the core),
  // `@honeybbq/teamspeak/client`, `@honeybbq/teamspeak/query`,
  // `@honeybbq/teamspeak/stream` and `@honeybbq/teamspeak/versions`, each named
  // by an `@module` tag in its entry file; scripts/check-site.mts fails when
  // one is missing. The client's and query's
  // declarations refer to the core through the package's own name, which
  // resolves to the sources, so {@link}s between the entries work and no
  // build is needed before running typedoc.
  "name": "teamspeak-js",
  "entryPoints": [
    "src/core/index.ts",
    "src/client/index.ts",
    "src/query/index.ts",
    "src/stream/index.ts",
    "src/versions/index.ts",
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "readme": "README.md",
  "projectDocuments": [
    "docs/guide.md",
    "docs/configuration.md",
    "docs/streams.md",
    "docs/serverquery.md",
    "docs/flood-control.md",
    "docs/design.md",
    "docs/compatibility.md",
    "docs/architecture.md",
    "docs/migrating-to-1.0.md",
    "docs/voice-protocol-responses.md",
    "docs/serverquery-responses.md",
  ],
  "out": "dist/docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeNotDocumented": false,
  "githubPages": true,
  "favicon": "docs/assets/favicon.svg",
  "customCss": "docs/assets/typedoc.css",
  // Each enumeration is `typeof xValues`, a helper const that is private to its
  // file; its members are documented on the exported const of the same
  // shape (Codec, ErrorCode, ClientStatus, ConnectPhase, ...). The
  // `__object.*` entries are the members of those helpers that other types
  // refer to, as KickReason does to Reason.KickChannel.
  "intentionallyNotExported": [
    "apiKeyScopeValues",
    "groupAutoUpdateTypeValues",
    "clientStatusValues",
    "connectPhaseValues",
    "clientTypeValues",
    "codecValues",
    "commandNameValues",
    "errorCodeValues",
    "eventNameValues",
    "connectionTrafficClassValues",
    "fileTransferStageValues",
    "queryEventCategoryValues",
    "queryEventNameValues",
    "serverFamilyValues",
    "uidAlgorithmValues",
    "viewStatusValues",
    "groupNameModeValues",
    "groupTypeValues",
    "groupWhisperScopeValues",
    "groupWhisperTypeValues",
    "hostMessageModeValues",
    "bannerModeValues",
    "bindingSubsystemValues",
    "codecEncryptionModeValues",
    "resolveSourceValues",
    "virtualServerStatusValues",
    "logLevelValues",
    "notificationNameValues",
    "permissionNameValues",
    "permissionTargetValues",
    "joinRequestCloseCauseValues",
    "joinRequestEventNameValues",
    "joinRequestStateValues",
    "peerCloseCauseValues",
    "peerEventNameValues",
    "publishedStreamEventNameValues",
    "streamAccessibilityValues",
    "streamEndCauseValues",
    "streamSourceValues",
    "streamTransportValues",
    "streamWarningCodeValues",
    "streamsEventNameValues",
    "privilegeKeyTypeValues",
    "propertyNameValues",
    "reasonValues",
    "textMessageTargetValues",
    "__object.AllClients",
    "__object.Channel",
    "__object.ChannelClient",
    "__object.ChannelGroup",
    "__object.ChannelCommander",
    "__object.Client",
    "__object.KickChannel",
    "__object.KickServer",
    "__object.ServerGroup",
  ],
  // The Material 3 theme loads as a plugin and layers its own stylesheet over
  // the default theme; it registers no theme, so there is no `theme` option.
  // `themeColor` is the source colour the palette is derived from.
  // scripts/typedoc-router.mjs keeps the versions table on one page.
  "plugin": ["typedoc-material-theme", "./scripts/typedoc-router.mjs"],
  "router": "teamspeak",
  "themeColor": "#2580e8",
  "treatWarningsAsErrors": true,
}

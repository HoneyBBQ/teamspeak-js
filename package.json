{
  "name": "@honeybbq/teamspeak",
  "version": "1.0.0-beta.20",
  "description": "TeamSpeak SDK for TypeScript: an independent voice client for Node.js, and the typed commands, ids and errors every connection shares",
  "keywords": [
    "client",
    "sdk",
    "teamspeak",
    "ts3",
    "ts6",
    "voip"
  ],
  "homepage": "https://github.com/HoneyBBQ/teamspeak-js#readme",
  "bugs": {
    "url": "https://github.com/HoneyBBQ/teamspeak-js/issues"
  },
  "license": "MIT",
  "author": "honeybbq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBBQ/teamspeak-js.git"
  },
  "files": [
    "dist/core",
    "dist/client",
    "dist/query",
    "dist/stream",
    "dist/versions",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*.typetest.ts",
    "!src/client/testing",
    "!src/stream/testing",
    "!src/query/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/core/index.ts",
    "./client": "./src/client/index.ts",
    "./query": "./src/query/index.ts",
    "./stream": "./src/stream/index.ts",
    "./versions": "./src/versions/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./query": {
        "types": "./dist/query/index.d.ts",
        "default": "./dist/query/index.js"
      },
      "./stream": {
        "types": "./dist/stream/index.d.ts",
        "default": "./dist/stream/index.js"
      },
      "./versions": {
        "types": "./dist/versions/index.d.ts",
        "default": "./dist/versions/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --project @honeybbq/teamspeak --project scripts",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "test:integration": "vitest run --project integration --exclude src/query/instance.integration.test.ts --reporter=verbose",
    "test:integration:client": "vitest run --project integration src/client/ --reporter=verbose",
    "test:integration:query": "vitest run --project integration src/query/ --exclude src/query/instance.integration.test.ts --reporter=verbose",
    "test:integration:instance": "TEAMSPEAK_QUERY_DESTRUCTIVE=1 TEAMSPEAK_QUERY_STOP_INSTANCE=1 vitest run --project integration src/query/instance.integration.test.ts --reporter=verbose",
    "test:integration:ts3": "TEAMSPEAK_ADDR=127.0.0.1:9987 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:ts6": "TEAMSPEAK_ADDR=127.0.0.1:9988 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:both": "pnpm test:integration:ts3 && pnpm test:integration:ts6",
    "changeset": "changeset",
    "version-packages": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} changeset version && pnpm install --lockfile-only",
    "check:changesets": "node scripts/check-changesets.mts",
    "check:docs": "node scripts/check-docs.mts",
    "check:theme": "pnpm docs:build && node scripts/check-theme.mts",
    "api:report": "pnpm build && api-extractor run --local -c api-extractor.core.json && api-extractor run --local -c api-extractor.client.jsonc && api-extractor run --local -c api-extractor.query.jsonc && api-extractor run --local -c api-extractor.stream.jsonc",
    "api:check": "pnpm build && node scripts/api-check.mts",
    "docs:build": "typedoc",
    "example": "tsx examples/connect.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@honeybbq/teamspeak": "link:.",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "ssh2": "^1.17.0",
    "tsx": "^4.21.0",
    "typedoc": "0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "werift": "^0.25.1"
  },
  "peerDependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "ssh2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1"
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "promise", "node", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
  "rules": {
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-shadow": "error",
    "no-useless-constructor": "off",
    "no-underscore-dangle": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-default-export": "error",
    "import/no-named-as-default-member": "off",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "separate-type-imports" }],
    "typescript/consistent-type-exports": "error",
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-deprecated": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "promise/always-return": "off",
    "promise/no-promise-in-callback": "off",
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/client",
                  "**/client/**",
                  "**/query",
                  "**/query/**",
                  "**/versions",
                  "**/versions/**",
                ],
                "message": "core is the shared base and must not import client, query or versions.",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/query", "**/query/**", "**/versions", "**/versions/**"],
                "message": "client must not import query or versions.",
              },
              {
                "group": ["**/core/**", "!**/core/internal.js"],
                "message": "Import the core's public API from \"@honeybbq/teamspeak\", or plumbing from the core/internal.js barrel.",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/query/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/client", "**/client/**", "**/versions", "**/versions/**"],
                "message": "query must not import client or versions.",
              },
              {
                "group": ["**/core/**", "!**/core/internal.js"],
                "message": "Import the core's public API from \"@honeybbq/teamspeak\", or plumbing from the core/internal.js barrel.",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/stream/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/client",
                  "**/client/**",
                  "**/query",
                  "**/query/**",
                  "**/versions",
                  "**/versions/**",
                ],
                "message": "stream takes the client it attaches to as a StreamsClient and must not import client, query or versions.",
              },
              {
                "group": ["**/core/**", "!**/core/internal.js"],
                "message": "Import the core's public API from \"@honeybbq/teamspeak\", or plumbing from the core/internal.js barrel.",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/versions/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            // The one thing versions takes from the package is the type its
            // entries have; a type import is erased, so it loads nothing.
            "paths": [
              {
                "name": "@honeybbq/teamspeak",
                "allowImportNames": ["ClientVersion"],
                "message": "versions imports only the ClientVersion type from the core.",
              },
            ],
            "patterns": [
              {
                "group": [
                  "**/core",
                  "**/core/**",
                  "**/client",
                  "**/client/**",
                  "**/query",
                  "**/query/**",
                  "@honeybbq/teamspeak/*",
                ],
                "message": "versions imports only the ClientVersion type from \"@honeybbq/teamspeak\", nothing from core, client or query.",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["**/*.test.ts", "**/testing/**"],
      "plugins": ["vitest"],
      "rules": {
        "no-restricted-imports": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/valid-expect": "off",
        // The fuzz tests assert inside fc.assert, which the rule cannot see.
        "vitest/expect-expect": "off",
        // The tests name the error class on purpose; the message is not the contract.
        "vitest/require-to-throw-message": "off",
      },
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "unicorn/no-process-exit": "off",
      },
    },
    {
      "files": ["**/*.config.ts"],
      "rules": { "import/no-default-export": "off" },
    },
  ],
  "ignorePatterns": ["dist/**", "node_modules/**"],
}
